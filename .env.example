DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mcqs_app
DB_PASSWORD=replace-with-a-local-password
DB_NAME=mcqs_website
DB_POOL_SIZE=10

# Required for admin and learner sign-in sessions.
ADMIN_EMAIL=admin@mcqpath.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SESSION_SECRET=replace-with-a-long-random-secret

# Replace with your public website origin before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: required for production learner verification and password reset emails.
RESEND_API_KEY=
RESEND_FROM=
